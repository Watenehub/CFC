FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/?retryWrites=true&w=majority
MONGO_DB_NAME=cornerstone_family_chapel

# Comma-separated exact frontend origins. Do not use *.
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Optional regex for Vercel preview URLs, e.g. https://.*-yourteam\.vercel\.app
# FRONTEND_ORIGIN_REGEX=

# Cookies: use Lax when API and site share a domain. Use None + HTTPS for a split Vercel/API setup.
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=true
SESSION_HOURS=8

# Set true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# Optional Redis URL for rate limits across multiple workers
# RATELIMIT_STORAGE_URI=memory://

# Password reset email (optional; requests still succeed if unset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.org
# SMTP_TLS=true

# Development only. Never enable in production.
# MONGO_TLS_ALLOW_INVALID=false

# M-PESA Daraja Configuration
# Get credentials from https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_PASSKEY=your_passkey_here
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
MPESA_ENVIRONMENT=sandbox

# Set to 'true' to use simulated mode when Daraja sandbox is unavailable
# MPESA_USE_SIMULATED=true
