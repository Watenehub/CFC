APP_ENV=development
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/?retryWrites=true&w=majority
MONGO_DB_NAME=cornerstone_family_chapel

# Comma-separated exact frontend origins. Do not use *.
CORS_ORIGINS=http://localhost:3000

# Render production settings (configure in Render's secret/environment dashboard)
# APP_ENV=production
# CORS_ORIGINS=https://cfckenya.vercel.app
# SESSION_COOKIE_SAMESITE=None
# INITIAL_ADMIN_EMAIL=admin@cornerstonechapel.org
# INITIAL_ADMIN_PASSWORD=<unique strong 12+ character password>

# Cookies: use Lax when API and site share a domain. Use None + HTTPS for a split Vercel/API setup.
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=true
SESSION_HOURS=8

# Set true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# Production: configure a shared Redis-compatible rate-limit store.
# Development-only fallback is in-memory and resets on process restart.
# Production must use shared Redis-compatible storage across instances.
# RATELIMIT_STORAGE_URI=rediss://USER:PASSWORD@HOST:PORT/0
# RATELIMIT_DEFAULT=300 per minute

# Development only. Never enable in production.
# MONGO_TLS_ALLOW_INVALID=false

# M-PESA Daraja Configuration
# Get credentials from https://developer.safaricom.co.ke/

# SANDBOX CONFIGURATION (Development)
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_PASSKEY=replace-with-sandbox-passkey-from-secret-store
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
MPESA_CALLBACK_TOKEN=replace-with-a-long-random-callback-secret
MPESA_ENVIRONMENT=sandbox

# PRODUCTION CONFIGURATION (Live Payments)
# For production, obtain production credentials from Safaricom Daraja:
# MPESA_CONSUMER_KEY=your_production_consumer_key
# MPESA_CONSUMER_SECRET=your_production_consumer_secret
# MPESA_PASSKEY=your_production_passkey
# MPESA_SHORTCODE=your_production_paybill_number
# MPESA_CALLBACK_URL=https://your-production-domain.com/api/mpesa/callback
# MPESA_CALLBACK_TOKEN=replace-with-a-different-long-random-production-secret
# MPESA_ENVIRONMENT=production

# CONFIGURATION NOTES:
# MPESA_ENVIRONMENT: "sandbox" for testing, "production" for live payments
# MPESA_SHORTCODE: Sandbox uses 174379, production uses your actual paybill/till
# MPESA_CALLBACK_URL: Must be HTTPS and publicly accessible for production
# Production callback URL requires valid SSL certificate
# Never commit actual credentials to git repository

# TESTING MODE:
# Set to 'true' to use simulated mode when Daraja sandbox is unavailable
# MPESA_USE_SIMULATED=true
# Set to 'false' or remove for real Daraja integration
# MPESA_USE_SIMULATED=false
